# Function to get count data for each taxonomic level
get_abundance <- function(input, level=NULL, abundance_type) {

  # error if abundance type does not match
  stopifnot(abundance_type %in% c("count", "rel", "clr"))

  if (is.null(level)) {

    results <- list()
    for (aa in names(input)) {
      cat("Subsetting", abundance_type, "for", aa, "\n")

      master <- input[["L8"]][[abundance_type]]
      test <- input[[aa]][[abundance_type]]

      # subset by matching to master
      test <- subset.data.frame(x = test, select = colnames(master))

      # check if sample names matches
      stopifnot(all(colnames(master) == colnames(test)))

      # combine all
      results[[aa]] <- test %>% mutate(taxonomic_rank=aa) %>%
        rownames_to_column("taxa") %>% select(taxa, taxonomic_rank, everything())
    }
    # combine all
    final <- bind_rows(results)
    return(final)

  } else {
    # get specific level only
    aa <- level
    cat("Subsetting", abundance_type, "for", aa, "\n")

    master <- input[["L8"]][[abundance_type]]
    test <- input[[aa]][[abundance_type]]

    # subset by matching to master
    test <- subset.data.frame(x = test, select = colnames(master))

    # check if sample names matches
    stopifnot(all(colnames(master) == colnames(test)))

    # combine all
    results <- test %>% mutate(taxonomic_rank=aa) %>%
      rownames_to_column("taxa") %>% select(taxa, taxonomic_rank, everything())
    return(results)
  }
}

