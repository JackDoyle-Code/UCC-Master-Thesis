# Example binary classification dataset
set.seed(123)
data <- twoClassSim(100)
trainIndex <- createDataPartition(data$Class, p = .8,
list = FALSE,
times = 1)
trainData <- data[ trainIndex,]
testData  <- data[-trainIndex,]
# Train a simple logistic regression model
model <- train(Class ~ ., data = trainData, method = "glm", family = "binomial")
# Make predictions on the test data
predictions <- predict(model, testData)
probs <- predict(model, testData, type = "prob")
# Calculate MultiClassSummary metrics
results <- data.frame(obs = testData$Class,
pred = predictions,
p1 = probs[,1],
p2 = probs[,2])
metrics <- multiClassSummary(results, lev = levels(testData$Class))
print(metrics)
