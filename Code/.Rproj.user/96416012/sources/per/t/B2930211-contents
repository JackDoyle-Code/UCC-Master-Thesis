#### Pred wrapper for fastshap #####
pred_train <- function(x, newdata) {
  if (x$modelType == "Classification") {
    predict(x, newdata, type="prob")[,2]
  } else {
    predict(x, newdata)
  }
}

# estimate feature importance by shap values
shap <- explain(object = trained_model_caret, X=test_data, pred_wrapper = pred_train, nsim = 5)
plot_shap_beeswarm(shap = shap, x = test_data, size=1)
plot_shap_bar(shap = shap, x = test_data)





#### Plot per fold AUC
uniq_obs <- levels(trained_model_caret$pred$obs)
for_lift <- tibble(obs = trained_model_caret$pred$obs, pred = trained_model_caret$pred$CD, resample = trained_model_caret$pred$Resample)
for_lift <- for_lift %>% separate(col = resample, into = c("folds", "reps"), sep = "\\.", remove = FALSE)
lift_df <-  tibble()
for (fold in unique(for_lift$folds)) {
  fold_df <- dplyr::filter(for_lift, folds == fold)
  lift_obj_data <- lift(obs ~ pred, data = fold_df, class = uniq_obs[1])$data
  lift_obj_data$fold <- fold
  lift_df <- bind_rows(lift_df, lift_obj_data) 
}
roc(for_lift$obs, for_lift$pred, ci=T)

ggplot(lift_df) +
    geom_line(aes(1 - Sp, Sn, color = fold)) +
    scale_color_discrete(guide = guide_legend(title = "Fold"))


